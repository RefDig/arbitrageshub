# Example .env for BuilderLYs SaaS

NODE_ENV=production
PORT=8080

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=builderlys
DB_PASSWORD=changeme
DB_NAME=builderlys

# JWT/OAuth
JWT_SECRET=changeme
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Stripe/PayPal
STRIPE_API_KEY=
PAYPAL_API_KEY=

# SMTP (email notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Other
FRONTEND_URL=https://builderlys.com
STUDIO_URL=https://studio.builderlys.com
